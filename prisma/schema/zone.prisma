model Zone {
  id          String  @id @default(uuid())
  name        String
  code        String  @unique
  description String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  substations Substation[] //one zone have many substation

  @@index([name]) //make searching zones by name faster.
  @@index([isActive])
  @@map("zones")
}
